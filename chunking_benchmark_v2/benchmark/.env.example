# Vector-retrieval (hybrid) config for the chunking benchmark.
# Copy to `.env` and `source` it, or just `export` these before running eval.
# With none of these set, retrieval runs BM25-only (degraded=True) — still works.

# --- Option A: OpenAI ---------------------------------------------------------
# pip install openai
# export LF_EMBEDDING_PROVIDER=openai
# export OPENAI_API_KEY=sk-...
# export LF_EMBEDDING_MODEL=text-embedding-3-small   # or text-embedding-3-large
# export LF_EMBEDDING_DIM=1024

# --- Option B: Voyage ---------------------------------------------------------
# pip install voyageai
# export LF_EMBEDDING_PROVIDER=voyage
# export VOYAGE_API_KEY=pa-...
# export LF_EMBEDDING_MODEL=voyage-3
# export LF_EMBEDDING_DIM=1024

# Verify the key end-to-end (from benchmark/):
#   python -m scripts.lib.embeddings --selftest
# Then re-run eval to get true hybrid (BM25 + vector RRF) numbers:
#   python -m scripts.eval_retrieval --k 5
