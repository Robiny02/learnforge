# 复制本文件为 .env（已被 .gitignore 忽略），填入真实 key。
# .env 只存在本地，不会进 git，也不会被烤进 MCP 配置文件。

# 用于 gpt-image 出图（scripts/mcp_gpt_image.py 在启动时从 .env 读取）
OPENAI_API_KEY=

# 用于 GitHub MCP 只读（读 repo/目录/源码/issues/PR）。建议只给只读 scope（public_repo）。
GITHUB_PERSONAL_ACCESS_TOKEN=

# 用于 Notion MCP / notion.sync。真实 token 放本地 .env，不要提交。
NOTION_TOKEN=
NOTION_PARENT_PAGE=

# 启用 LearnForge 内置 stdio MCP server：notion / web / github。
# 未启用时不会启动子进程；仍可用 LF_MCP_SERVERS 接第三方 MCP server。
LF_ENABLE_BUILTIN_MCP=1
